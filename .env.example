# Supabase project URL & publishable key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key (NEVER prefix with NEXT_PUBLIC_)
# Required for user creation, invites, and session revocation in Team & access.
# Found in Supabase Dashboard -> Project Settings -> API Keys -> Secret key
SUPABASE_SECRET_KEY=sb_secret_...
