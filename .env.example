# Supabase project URL & publishable key. Server-only: the browser never talks
# to Supabase, so don't prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key (NEVER prefix with NEXT_PUBLIC_)
# Required for sign-in (lockout, session lifetime, per-visitor rate limits via
# Sb-Forwarded-For), user creation, invites, and session revocation.
# Found in Supabase Dashboard -> Project Settings -> API Keys -> Secret key
SUPABASE_SECRET_KEY=sb_secret_...

# Public address of the app, used for links in emails (invites, resets, unlocks).
# Required in production; never derived from the request there.
APP_URL=https://quotes.majeursholdings.com

# Outgoing email (nodemailer over SMTP). Supabase sends nothing.
# Production uses Google Workspace:
#   - SMTP_USER is a real Workspace mailbox (e.g. no-reply@majeursholdings.com).
#   - SMTP_PASSWORD is a 16-character App Password for that mailbox, not its normal
#     password (the mailbox needs 2-Step Verification on; Google Account ->
#     Security -> App passwords). The Workspace admin must allow app passwords.
#   - EMAIL_FROM must be that mailbox, or an alias added to it under Gmail
#     "Send mail as"; otherwise Google rewrites the sender.
#   - Limit: about 2,000 emails a day per mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@majeursholdings.com
SMTP_PASSWORD=
EMAIL_FROM="Majeurs <no-reply@majeursholdings.com>"

# Optional: Supabase Storage S3-compatible protocol credentials (for AWS CLI,
# rclone, or server-side S3 scripts only; app uploads use supabase.storage with RLS).
# Generate keys in Supabase Dashboard -> Storage -> Settings -> S3 Access Keys.
# SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=eu-west-1
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=

# Encrypts the AI providers' API keys (Settings › Custom design agent) before
# they're stored. 32+ random characters, e.g. `openssl rand -base64 32`.
# Keep it stable: changing it makes saved keys unreadable, so they'd need
# entering again. Server-only (NEVER prefix with NEXT_PUBLIC_).
AI_KEYS_SECRET=
